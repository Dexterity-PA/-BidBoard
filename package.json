{
  "name": "bidboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:release && node scripts/migrate-newsletter.mjs && node scripts/migrate-analytics.mjs && node scripts/migrate-account-health.mjs && next build && node scripts/sync-catalog-audit.mjs",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "check:release": "next typegen && tsc --noEmit && vitest run"
  },
